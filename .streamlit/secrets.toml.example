# Copy this file to .streamlit/secrets.toml and fill in your own key.
# .streamlit/secrets.toml is gitignored — it never gets committed.
#
# Get a free Geoapify key at https://www.geoapify.com (free tier:
# 3,000 requests/day) — used by the Geocoding tab.

GEOAPIFY_API_KEY = "your-geoapify-api-key-here"
